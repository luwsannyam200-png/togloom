{
  "rules": {
    "names": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24"
      }
    },
    "prof": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['e', 'c', 'g', 's', 'w', 'p'])",
        "e": { ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() <= 15" },
        "c": { ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() <= 7" },
        "g": { ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9]{0,10}$/)" },
        "s": { ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() <= 9" },
        "w": { ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() <= 9" },
        "p": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= now + 60000" },
        "tm": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "$other": { ".validate": false }
      }
    },
    "pics": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['d', 'at'])",
        "d": { ".validate": "newData.isString() && newData.val().length <= 24100 && newData.val().beginsWith('data:image/jpeg;base64,')" },
        "at": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
        "$other": { ".validate": false }
      }
    },
    "scores": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "$game": {
          ".validate": "$game.matches(/^(flappy|race|puzzle|quiz|chess|fps|cs2|blok|ludo|imp)$/) && newData.hasChildren(['best', 'at'])",
          "best": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000" },
          "at": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
          "db": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000" },
          "wb": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000" },
          "dk": { ".validate": "newData.isNumber() && newData.val() <= (now + 28800000) / 86400000 + 1" },
          "wk": { ".validate": "newData.isNumber() && newData.val() <= (now + 28800000) / 604800000 + 2" },
          "$other": { ".validate": false }
        }
      }
    },
    "quizsets": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "sets": {
          "$sid": {
            ".validate": "$sid.matches(/^[a-z0-9]{1,16}$/) && newData.hasChildren(['title', 'sec', 'qs', 'at'])",
            "title": { ".validate": "newData.isString() && newData.val().length <= 60" },
            "sec": { ".validate": "newData.val() === 10 || newData.val() === 15 || newData.val() === 20 || newData.val() === 30" },
            "at": { ".validate": "newData.isNumber()" },
            "qs": {
              "$i": {
                ".validate": "$i.matches(/^([0-9]|[1-3][0-9])$/) && newData.hasChildren(['q', 'o', 'k'])",
                "q": { ".validate": "newData.isString() && newData.val().length <= 300" },
                "k": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3" },
                "o": {
                  "$j": { ".validate": "$j.matches(/^[0-3]$/) && newData.isString() && newData.val().length <= 120" }
                },
                "$other": { ".validate": false }
              }
            },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    },
    "tours": {
      ".read": "auth != null",
      "$tid": {
        ".write": "auth != null && $tid.matches(/^[a-z0-9]{1,12}$/) && (data.exists() ? data.child('by').val() === auth.uid : newData.child('by').val() === auth.uid)",
        "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60" },
        "by": { ".validate": "newData.isString() && newData.val().length <= 128" },
        "status": { ".validate": "newData.val() === 'join' || newData.val() === 'play' || newData.val() === 'done'" },
        "at": { ".validate": "newData.isNumber()" },
        "started": { ".validate": "newData.isNumber()" },
        "ended": { ".validate": "newData.isNumber()" },
        "order": {
          "$i": { ".validate": "$i.matches(/^[0-9]{1,2}$/) && newData.isString() && newData.val().length <= 128" }
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('tours').child($tid).child('status').val() === 'join'",
            ".validate": "newData.hasChildren(['at'])",
            "at": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "games": {
          "$pid": {
            ".write": "auth != null && root.child('tours').child($tid).child('status').val() === 'play' && (newData.child('w').val() === auth.uid || newData.child('b').val() === auth.uid)",
            ".validate": "$pid.matches(/^p[0-9]{1,2}-[0-9]{1,2}$/) && newData.hasChildren(['w', 'b', 'res', 'at'])",
            "w": { ".validate": "newData.isString() && newData.val().length <= 128" },
            "b": { ".validate": "newData.isString() && newData.val().length <= 128" },
            "res": { ".validate": "newData.val() === 'w' || newData.val() === 'b' || newData.val() === 'd'" },
            "how": { ".validate": "newData.val() === 'online' || newData.val() === 'board'" },
            "by": { ".validate": "newData.val() === auth.uid" },
            "at": { ".validate": "newData.isNumber()" },
            "n": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2000" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    },
    "codetours": {
      "$tid": {
        ".read": "auth != null",
        ".write": "auth != null && $tid.matches(/^[a-z0-9]{4,6}$/) && (data.exists() ? data.child('by').val() === auth.uid : newData.child('by').val() === auth.uid)",
        "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60" },
        "by": { ".validate": "newData.isString() && newData.val().length <= 128" },
        "status": { ".validate": "newData.val() === 'join' || newData.val() === 'play' || newData.val() === 'done'" },
        "at": { ".validate": "newData.isNumber()" },
        "started": { ".validate": "newData.isNumber()" },
        "ended": { ".validate": "newData.isNumber()" },
        "order": {
          "$i": { ".validate": "$i.matches(/^[0-9]{1,2}$/) && newData.isString() && newData.val().length <= 128" }
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('codetours').child($tid).child('status').val() === 'join'",
            ".validate": "newData.hasChildren(['at'])",
            "at": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "games": {
          "$pid": {
            ".write": "auth != null && root.child('codetours').child($tid).child('status').val() === 'play' && (newData.child('w').val() === auth.uid || newData.child('b').val() === auth.uid)",
            ".validate": "$pid.matches(/^p[0-9]{1,2}-[0-9]{1,2}$/) && newData.hasChildren(['w', 'b', 'res', 'at'])",
            "w": { ".validate": "newData.isString() && newData.val().length <= 128" },
            "b": { ".validate": "newData.isString() && newData.val().length <= 128" },
            "res": { ".validate": "newData.val() === 'w' || newData.val() === 'b' || newData.val() === 'd'" },
            "how": { ".validate": "newData.val() === 'online' || newData.val() === 'board'" },
            "by": { ".validate": "newData.val() === auth.uid" },
            "at": { ".validate": "newData.isNumber()" },
            "n": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2000" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    },
    "openarena": {
      ".read": "auth != null",
      "$code": {
        ".write": "auth != null && $code.matches(/^[A-Z0-9]{4,6}$/) && (data.exists() ? (data.child('by').val() === auth.uid || (!newData.exists() && data.child('seen').val() < now - 86400000)) : newData.child('by').val() === auth.uid)",
        "by": { ".validate": "newData.isString() && newData.val().length <= 128" },
        "at": { ".validate": "newData.isNumber()" },
        "seen": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
        "game": { ".validate": "newData.val() === 'flappy' || newData.val() === 'race' || newData.val() === 'puzzle' || newData.val() === 'quiz' || newData.val() === 'cs2' || newData.val() === 'blok'" },
        "mins": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 120" },
        "round": { ".validate": "newData.isString() && newData.val().length <= 12" },
        "start": { ".validate": "newData.isNumber()" },
        "ends": { ".validate": "newData.isNumber()" },
        "scores": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['best', 'at', 'round']) && newData.child('round').val() === root.child('openarena').child($code).child('round').val() && now <= root.child('openarena').child($code).child('ends').val() + 15000",
            "best": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000" },
            "at": { ".validate": "newData.isNumber()" },
            "round": { ".validate": "newData.isString()" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    },
    "openlive": {
      ".read": "auth != null",
      "$key": {
        ".write": "auth != null && ($key.endsWith('_' + auth.uid) || (!newData.exists() && data.child('at').val() < now - 86400000))",
        ".validate": "newData.hasChildren(['code', 'at']) && $key === newData.child('code').val() + '_' + auth.uid",
        "code": { ".validate": "newData.isString() && newData.val().matches(/^[A-Z0-9]{4,6}$/)" },
        "at": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
        "$other": { ".validate": false }
      }
    },
    "arena": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && $code.matches(/^[A-Z0-9]{4,6}$/) && (data.exists() ? data.child('by').val() === auth.uid : newData.child('by').val() === auth.uid)",
        "by": { ".validate": "newData.isString() && newData.val().length <= 128" },
        "at": { ".validate": "newData.isNumber()" },
        "game": { ".validate": "newData.val() === 'flappy' || newData.val() === 'race' || newData.val() === 'puzzle' || newData.val() === 'quiz' || newData.val() === 'cs2' || newData.val() === 'blok'" },
        "mins": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 120" },
        "round": { ".validate": "newData.isString() && newData.val().length <= 12" },
        "start": { ".validate": "newData.isNumber()" },
        "ends": { ".validate": "newData.isNumber()" },
        "scores": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['best', 'at', 'round']) && newData.child('round').val() === root.child('arena').child($code).child('round').val() && now <= root.child('arena').child($code).child('ends').val() + 15000",
            "best": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000" },
            "at": { ".validate": "newData.isNumber()" },
            "round": { ".validate": "newData.isString()" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    },
    "chinv": {
      "$to": {
        "in": {
          ".read": "auth != null && auth.uid === $to",
          "$from": {
            ".read": "auth != null && auth.uid === $from",
            ".write": "auth != null && (auth.uid === $from || (auth.uid === $to && !newData.exists() && data.child('at').val() < now - 86400000))",
            ".validate": "$from !== $to && newData.hasChildren(['id', 'w', 'room', 'at']) && (newData.child('w').val() === $from || newData.child('w').val() === $to)",
            "id": { ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9]{1,12}$/)" },
            "w": { ".validate": "newData.isString()" },
            "room": { ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9-]{1,24}$/)" },
            "tour": { ".validate": "newData.isString() && newData.val().matches(/^(x-)?[a-z0-9]{1,12}$/)" },
            "pair": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{1,2}-[0-9]{1,2}$/)" },
            "at": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
            "reply": {
              ".write": "auth != null && auth.uid === $to && data.parent().exists()",
              ".validate": "auth.uid === $to && (newData.val() === 'ok' || newData.val() === 'no')"
            },
            "$other": { ".validate": false }
          }
        }
      }
    },
    "notes": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null && root.child('noteadmin').child('pin').exists() && root.child('noteadmins').child(auth.uid).child('pin').val() === root.child('noteadmin').child('pin').val() && ((!data.exists() && newData.exists() && newData.child('s').val() === (root.child('notemeta').child('s').exists() ? root.child('notemeta').child('s').val() : 0) + 1) || !newData.exists())",
        ".validate": "$id.matches(/^[a-z0-9]{8,20}$/) && newData.hasChildren(['t', 'd', 's', 'f'])",
        "t": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 280" },
        "to": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 30" },
        "d": { ".validate": "newData.isNumber() && ((newData.val() + 28800000) % 86400000 === 0 || newData.val() % 86400000 === 0) && newData.val() <= now && newData.val() > now - 172800000" },
        "s": { ".validate": "newData.isNumber() && newData.val() === newData.parent().parent().parent().child('notemeta').child('s').val()" },
        "f": {
          ".write": "auth != null && data.exists() && ((newData.val() === data.val() + 1 && !root.child('noterep').child($id).child(auth.uid).exists() && newData.parent().parent().parent().child('noterep').child($id).child(auth.uid).val() === true) || (newData.val() === 0 && root.child('noteadmin').child('pin').exists() && root.child('noteadmins').child(auth.uid).child('pin').val() === root.child('noteadmin').child('pin').val()))",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000 && (data.exists() || newData.val() === 0)"
        },
        "$other": { ".validate": false }
      }
    },
    "cs2": {
      "q": {
        ".read": "auth != null",
        "$id": {
          ".write": "auth != null && $id.matches(/^[a-z0-9]{8,20}$/) && (data.exists() ? data.child('by').val() === auth.uid : newData.child('by').val() === auth.uid)",
          ".validate": "newData.hasChildren(['q', 'o', 'k', 'by', 'at'])",
          "q": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200" },
          "o": {
            "$j": { ".validate": "$j.matches(/^[0-3]$/) && newData.isString() && newData.val().length >= 1 && newData.val().length <= 80" }
          },
          "k": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3" },
          "img": { ".validate": "newData.isString() && newData.val().length <= 200 && newData.val().matches(/^img\\/[A-Za-z0-9_.\\/-]{1,120}\\.(png|jpg|jpeg|webp|gif|PNG|JPG|JPEG|WEBP|GIF)$/)" },
          "by": { ".validate": "newData.val() === auth.uid" },
          "at": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      },
      "lu": {
        ".read": "auth != null",
        "$id": {
          ".write": "auth != null && $id.matches(/^[a-z0-9]{8,20}$/) && (data.exists() ? data.child('by').val() === auth.uid : newData.child('by').val() === auth.uid)",
          ".validate": "newData.hasChildren(['map', 't', 'n', 'sx', 'sy', 'lx', 'ly', 'how', 'ok', 'by', 'at'])",
          "map": { ".validate": "newData.val() === 'mirage' || newData.val() === 'dust2' || newData.val() === 'inferno'" },
          "t": { ".validate": "newData.val() === 'smoke' || newData.val() === 'flash' || newData.val() === 'molotov' || newData.val() === 'he'" },
          "n": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40" },
          "sx": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
          "sy": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
          "lx": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
          "ly": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
          "how": { ".validate": "newData.val() === 'left' || newData.val() === 'jump' || newData.val() === 'run' || newData.val() === 'right' || newData.val() === 'both' || newData.val() === 'walk'" },
          "aim": { ".validate": "newData.isString() && newData.val().length <= 200" },
          "yt": { ".validate": "newData.isString() && newData.val().length <= 200 && newData.val().matches(/^https:\\/\\/(www\\.)?(youtube\\.com|youtu\\.be)\\//)" },
          "who": { ".validate": "newData.isString() && newData.val().length <= 24" },
          "by": { ".validate": "newData.isString()" },
          "at": { ".validate": "newData.isNumber()" },
          "ok": {
            ".write": "auth != null && root.child('noteadmin').child('pin').exists() && root.child('noteadmins').child(auth.uid).child('pin').val() === root.child('noteadmin').child('pin').val()",
            ".validate": "newData.isBoolean() && (newData.val() === false || (root.child('noteadmin').child('pin').exists() && root.child('noteadmins').child(auth.uid).child('pin').val() === root.child('noteadmin').child('pin').val()))"
          },
          "$other": { ".validate": false }
        }
      }
    },
    "notesq": {
      ".read": "auth != null && root.child('noteadmin').child('pin').exists() && root.child('noteadmins').child(auth.uid).child('pin').val() === root.child('noteadmin').child('pin').val()",
      "$id": {
        ".write": "auth != null && $id.matches(/^[a-z0-9]{8,20}$/) && ((!data.exists() && newData.exists() && newData.parent().parent().child('notelimit').child(auth.uid).child('n').val() === (root.child('notelimit').child(auth.uid).child('d').val() === newData.child('d').val() ? root.child('notelimit').child(auth.uid).child('n').val() + 1 : 1)) || (!newData.exists() && root.child('noteadmin').child('pin').exists() && root.child('noteadmins').child(auth.uid).child('pin').val() === root.child('noteadmin').child('pin').val()))",
        ".validate": "newData.hasChildren(['t', 'd'])",
        "t": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 280" },
        "to": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 30" },
        "d": { ".validate": "newData.isNumber() && ((newData.val() + 28800000) % 86400000 === 0 || newData.val() % 86400000 === 0) && newData.val() <= now && newData.val() > now - 172800000" },
        "$other": { ".validate": false }
      }
    },
    "ads": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null && $id.matches(/^[a-z0-9]{8,20}$/) && (data.exists() ? (data.child('by').val() === auth.uid ? true : (!newData.exists() && root.child('noteadmin').child('pin').exists() && root.child('noteadmins').child(auth.uid).child('pin').val() === root.child('noteadmin').child('pin').val())) : newData.child('by').val() === auth.uid)",
        ".validate": "newData.hasChildren(['t', 'by', 'at', 'until'])",
        "t": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60" },
        "b": { ".validate": "newData.isString() && newData.val().length <= 400" },
        "when": { ".validate": "newData.isNumber()" },
        "room": { ".validate": "newData.isString() && newData.val().matches(/^[A-Z0-9]{4,6}$/)" },
        "tour": { ".validate": "newData.isString() && newData.val().matches(/^(x-)?[a-z0-9]{1,12}$/)" },
        "who": { ".validate": "newData.isString() && newData.val().length <= 24" },
        "by": { ".validate": "newData.isString() && newData.val().length <= 128" },
        "at": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
        "until": { ".validate": "newData.isNumber() && newData.val() <= now + 5270400000" },
        "$other": { ".validate": false }
      }
    },
    "notemeta": {
      "s": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
      }
    },
    "notelimit": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['d', 'n']) && newData.child('d').isNumber() && ((newData.child('d').val() + 28800000) % 86400000 === 0 || newData.child('d').val() % 86400000 === 0) && newData.child('d').val() <= now && (!data.exists() || newData.child('d').val() >= data.child('d').val()) && newData.child('n').val() === (data.child('d').val() === newData.child('d').val() ? data.child('n').val() + 1 : 1) && newData.child('n').val() <= 5",
        "d": { ".validate": "newData.isNumber()" },
        "n": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },
    "noterep": {
      "$id": {
        ".write": "auth != null && !newData.exists() && root.child('noteadmin').child('pin').exists() && root.child('noteadmins').child(auth.uid).child('pin').val() === root.child('noteadmin').child('pin').val()",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('notes').child($id).exists()",
          ".validate": "newData.val() === true && newData.parent().parent().parent().child('notes').child($id).child('f').val() === root.child('notes').child($id).child('f').val() + 1"
        }
      }
    },
    "noteadmins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
